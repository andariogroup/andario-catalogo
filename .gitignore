# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/coverage/
*.lcov
.nyc_output/

# next.js
/.next/
/out/
.swc/

# production
/build
/dist

# misc / OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.pem
*.key
*.p12
*.pfx
*.crt

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel / local deploy metadata
.vercel

# typescript
*.tsbuildinfo

# tooling caches
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo/
.cache/
.parcel-cache/
.vite/

# IDE / editor (local)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.cursor/
*.code-workspace

# playwright / e2e artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# local scratch / temp
tmp/
temp/
*.tmp
*.temp
.local/

# optional local dumps (never commit secrets or DB dumps)
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
