# Base de desarrollo aislada. No uses la base de otro producto Andario.
DATABASE_URL=postgresql://usuario:clave@host/andario_catalogo_dev?sslmode=require
AUTH_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave
# Alta inicial (db:setup). En producción TRINITARIAS usar: BUSINESS_NAME=TRINITARIAS
BUSINESS_NAME=Mi negocio
# Local: http://localhost:3020. Producción TRINITARIAS: https://www.trinitarias.co (sin barra final).
# Respaldo si public_url en admin está vacío; el canónico definitivo sale de admin SEO → URL pública.
NEXT_PUBLIC_APP_URL=http://localhost:3020
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Solo para datos de prueba locales. Nunca en producción.
SEED_DEMO=0
